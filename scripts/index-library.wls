#!/usr/bin/env wolframscript
(*  Rebuilds library/INDEX.md from the (* ::Library:: ... :: *) header of every
    library/*.wl file.  The index is a build product precisely so it cannot
    drift away from what it catalogues - never hand-edit it.

        wolframscript -file scripts/index-library.wls
*)

$skill   = ParentDirectory[DirectoryName[$InputFileName]];
$library = FileNameJoin[{$skill, "library"}];
$index   = FileNameJoin[{$library, "INDEX.md"}];

(* ---- header parsing ------------------------------------------------ *)

headerBlock[text_String] :=
    Replace[
        StringCases[text, "(* ::Library::" ~~ Shortest[b___] ~~ ":: *)" :> b, 1],
        {{b_} :> b, _ -> None}];

(* values may carry a trailing (* comment *); drop it *)
cleanValue[v_String] := StringTrim @ StringReplace[v, "(*" ~~ Shortest[___] ~~ "*)" -> ""];

parseHeader[block_String] :=
    Association @ Cases[
        StringSplit[block, "\n"],
        line_String /; StringContainsQ[line, ":"] :>
            With[{p = StringSplit[line, ":", 2]},
                StringTrim[p[[1]]] -> cleanValue[p[[2]]]]];

entryFor[file_String] :=
    Module[{block = headerBlock @ Import[file, "Text"]},
        If[block === None,
            Missing["NoHeader", FileNameTake[file]],
            Append[parseHeader[block], "file" -> FileNameTake[file]]]];

(* ---- render -------------------------------------------------------- *)

cell[a_, k_, default_: "\[Dash]"] := Replace[Lookup[a, k, default], "" -> default];

row[a_] := StringJoin[
    "| `", cell[a, "name", FileBaseName @ a["file"]], "` | ",
    cell[a, "summary"], " | `", cell[a, "kernel", "any"], "` | `",
    cell[a, "provides"], "` | ", cell[a, "tags"], " | ",
    cell[a, "verified"], " |"];

Module[{files, entries, bad, good, text},
    If[!DirectoryQ[$library], CreateDirectory[$library, CreateIntermediateDirectories -> True]];
    files   = Sort @ FileNames["*.wl", $library];
    entries = entryFor /@ files;
    bad     = Cases[entries, _Missing];
    good    = SortBy[Cases[entries, _Association], Lookup["name"]];

    text = StringJoin[
        "# Library index\n\n",
        "_Generated by `scripts/index-library.wls`. Do not edit by hand \[LongDash] ",
        "rerun the script after adding or changing an entry._\n\n",
        If[good === {},
            "No entries yet. See the skill's \"Adding an entry\" section for the bar and the header format.\n",
            StringJoin[
                ToString[Length[good]], " entr", If[Length[good] === 1, "y", "ies"], ".\n\n",
                "| name | summary | kernel | provides | tags | verified |\n",
                "| --- | --- | --- | --- | --- | --- |\n",
                StringRiffle[row /@ good, "\n"], "\n"]],
        If[bad === {}, "",
            "\n> **Missing `(* ::Library:: *)` header, so not indexed:** " <>
            StringRiffle[Last /@ bad, ", "] <> "\n"]];

    Export[$index, text, "Text"];
    Print["indexed ", Length[good], " entr", If[Length[good] === 1, "y", "ies"],
          " -> ", $index];
    If[bad =!= {}, Print["WARNING: no header, skipped: ", StringRiffle[Last /@ bad, ", "]]];
];
